# Kiowa Gun Club API configuration. Copy to backend/.env for local development.
# In production these are Render environment variables (see render.yaml);
# never commit real values.

# development | test | production  (production enforces the safety checks in app/core/config.py)
APP_ENV=development
# At least 32 random characters in production: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string-for-local-dev
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kiowa_gun_club

# Browser origins allowed to call the API with cookies (www, portal, apply, board).
CORS_ORIGINS=http://localhost:4173,http://localhost:5174,http://localhost:5173,http://localhost:4174
# Used to build links in emails and Stripe redirects.
PUBLIC_SITE_URL=http://localhost:4173
PORTAL_APP_URL=http://localhost:5174
APPLY_APP_URL=http://localhost:5173
BOARD_APP_URL=http://localhost:4174
API_PUBLIC_URL=http://localhost:8000

# Session cookies. COOKIE_SECURE defaults to on in production.
# COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=
# SESSION_TTL_HOURS=8
# REMEMBER_SESSION_DAYS=30

# Object storage. "local" is for development only and is refused in production.
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=.storage
# S3-compatible private bucket (AWS S3, Cloudflare R2, Backblaze B2):
# STORAGE_BACKEND=s3
# S3_BUCKET=
# S3_REGION=auto
# S3_ENDPOINT_URL=          # blank for AWS; e.g. https://<account>.r2.cloudflarestorage.com for R2
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
MAX_UPLOAD_MB=10

# Stripe (Checkout + webhook). Leave blank locally to disable online payment.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Email: resend | console (prints to the log; development only) | disabled
EMAIL_PROVIDER=console
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
EMAIL_FROM_ADDRESS=no-reply@kiowagunclub.org
EMAIL_FROM_NAME=Kiowa Gun Club
EMAIL_REPLY_TO=

# SMS: twilio | console (development only) | disabled
SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Use a Messaging Service SID (recommended for A2P 10DLC) or a From number.
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM_NUMBER=

# Bearer token for POST /api/jobs/{name} (external schedulers / manual runs).
CRON_SECRET=

# Optional error monitoring.
SENTRY_DSN=

# First deployment only: `python -m app.cli bootstrap-admin` creates this administrator.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_PASSWORD=

LOG_LEVEL=INFO
