APP_ENV=development
APP_SECRET=change-me
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kiowa_gun_club
CORS_ORIGINS=http://localhost:4173,http://localhost:5173,http://localhost:4174

# Veriphone resolves the CURRENT carrier when a user clicks Send/Submit.
VERIPHONE_API_KEY=
VERIPHONE_API_URL=https://api.veriphone.io/v2/verify
VERIPHONE_DEFAULT_COUNTRY=US
VERIPHONE_TIMEOUT_SECONDS=8

# SMTP is used both for normal email and carrier email-to-SMS gateways.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
SMTP_TIMEOUT_SECONDS=10
EMAIL_FROM=
NOTIFICATION_SUBJECT=Kiowa Gun Club application notification

# JSON: Veriphone carrier-name fragment -> carrier email-to-SMS gateway.
# Gateway can be a domain or a full template containing {number}.
# Example:
# SMS_GATEWAY_MAP={"t-mobile":"tmomail.net","verizon":"vtext.com"}
SMS_GATEWAY_MAP={}
